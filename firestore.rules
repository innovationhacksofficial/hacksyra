rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// HACKSYRA — Firestore security rules
// Principle: clients may only write owner-scoped data (profile, hackathon DRAFTS,
// project drafts, bookmarks, chat, notification read-state). Everything that
// involves money, status, counters, approval or deadlines is written by the
// server (Admin SDK bypasses these rules).
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function role() { return signedIn() && request.auth.token.role is string ? request.auth.token.role : 'participant'; }
    function isAdmin() { return role() in ['admin', 'super_admin']; }
    function isModerator() { return isAdmin() || role() == 'moderator'; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyChanges(keys) { return changed().hasOnly(keys); }
    function noneOf(keys) { return !changed().hasAny(keys); }
    function hackathon(id) { return get(/databases/$(database)/documents/hackathons/$(id)).data; }
    function ownsHackathon(h) { return signedIn() && (h.organizerId == uid() || (h.coOrganizerIds is list && uid() in h.coOrganizerIds)); }

    // Fields only the server may set on a hackathon.
    function hackathonServerFields() {
      return ['isListed', 'listingFee', 'review', 'approvedBy', 'approvedAt', 'rejectionReason',
              'isFeatured', 'isStaffPick', 'featuredUntil', 'registrationCount', 'teamCount',
              'submissionCount', 'viewCount', 'resultsPublished', 'isSeed', 'status'];
    }
    function editableStatus(s) { return s in ['draft', 'payment_pending', 'more_info_required', 'rejected']; }

    // ── users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if signedIn() && (uid() == userId || isAdmin());
      allow create: if false; // created by /api/users/bootstrap
      allow update: if signedIn() && uid() == userId && noneOf([
        'uid', 'email', 'username', 'roles', 'isBanned', 'isActive', 'emailVerified',
        'followersCount', 'followingCount', 'hackathonsJoined', 'projectsPublished', 'createdAt', 'planId'
      ]);
      allow delete: if false;
    }

    match /userProfiles/{userId} {
      allow read: if resource.data.isPublic == true || (signedIn() && (uid() == userId || isAdmin()));
      allow update: if signedIn() && uid() == userId && noneOf([
        'uid', 'username', 'hackathonsJoined', 'projectsPublished', 'achievements'
      ]);
      allow create, delete: if false;
    }

    match /usernames/{name} { allow read: if true; allow write: if false; }
    match /slugs/{slug}     { allow read: if true; allow write: if false; }

    // ── platform ───────────────────────────────────────────────────────────
    match /platformSettings/{id} { allow read: if true; allow write: if false; } // via /api/admin/settings
    match /stats/{id}            { allow read: if true; allow write: if false; }
    match /testimonials/{id}     { allow read: if resource.data.approved == true || isAdmin(); allow write: if false; }
    match /featureFlags/{id}     { allow read: if true; allow write: if false; }

    // ── hackathons ─────────────────────────────────────────────────────────
    match /hackathons/{hid} {
      allow get: if resource.data.isListed == true
                 || ownsHackathon(resource.data)
                 || isAdmin()
                 // unlisted / invite-only events are reachable by direct link once approved
                 || (resource.data.visibility in ['unlisted', 'invite_only']
                     && resource.data.status in ['approved','published','registration_open','registration_closed','ongoing','judging','results_announced','completed']);
      allow list: if resource.data.isListed == true || ownsHackathon(resource.data) || isAdmin();

      allow create: if signedIn()
        && request.resource.data.organizerId == uid()
        && request.resource.data.status == 'draft'
        && !request.resource.data.keys().hasAny(['isListed', 'listingFee', 'review', 'approvedBy', 'approvedAt',
              'isFeatured', 'isStaffPick', 'registrationCount', 'teamCount', 'submissionCount', 'resultsPublished', 'isSeed']);

      // Owners edit freely only while not live/under review, and never server fields.
      allow update: if ownsHackathon(resource.data)
        && editableStatus(resource.data.status)
        && request.resource.data.organizerId == resource.data.organizerId
        && noneOf(hackathonServerFields());

      allow delete: if ownsHackathon(resource.data) && resource.data.status == 'draft';

      match /announcements/{aid} {
        allow read: if hackathon(hid).isListed == true || ownsHackathon(hackathon(hid)) || isAdmin();
        allow write: if false; // via API (email blast + audit)
      }
      match /discussions/{tid} {
        allow read: if hackathon(hid).isListed == true || ownsHackathon(hackathon(hid)) || isAdmin();
        allow create: if signedIn() && request.resource.data.authorId == uid()
          && request.resource.data.title is string && request.resource.data.title.size() <= 200
          && request.resource.data.body is string && request.resource.data.body.size() <= 5000
          && request.resource.data.replyCount == 0;
        allow update: if signedIn() && (
             (resource.data.authorId == uid() && onlyChanges(['title', 'body', 'updatedAt', 'isAnswered']))
          || (ownsHackathon(hackathon(hid)) && onlyChanges(['isAnswered', 'updatedAt'])));
        allow delete: if signedIn() && (resource.data.authorId == uid() || isModerator());

        match /replies/{rid} {
          allow read: if hackathon(hid).isListed == true || ownsHackathon(hackathon(hid)) || isAdmin();
          allow create: if false; // via API (keeps replyCount + isOrganizer honest)
          allow update: if signedIn() && resource.data.authorId == uid() && onlyChanges(['body', 'updatedAt']);
          allow delete: if signedIn() && (resource.data.authorId == uid() || isModerator());
        }
      }
      match /judges/{judgeId} {
        allow read: if signedIn() && (uid() == judgeId || ownsHackathon(hackathon(hid)) || isAdmin());
        allow write: if false;
      }
    }

    // ── commerce (server-only writes) ──────────────────────────────────────
    match /ticketTiers/{id} {
      allow read: if resource.data.isPublic == true || (signedIn() && (resource.data.organizerId == uid() || isAdmin()));
      allow write: if false;
    }
    match /coupons/{id} {
      allow read: if signedIn() && (resource.data.organizerId == uid() || isAdmin());
      allow write: if false;
    }
    match /seatReservations/{id} { allow read: if signedIn() && resource.data.userId == uid(); allow write: if false; }

    match /registrations/{id} {
      allow read: if signedIn() && (resource.data.userId == uid() || resource.data.organizerId == uid() || isAdmin());
      allow write: if false;
    }

    match /orders/{id}   { allow read: if signedIn() && (resource.data.userId == uid() || resource.data.organizerId == uid() || isAdmin()); allow write: if false; }
    match /payments/{id} { allow read: if signedIn() && (resource.data.userId == uid() || resource.data.organizerId == uid() || isAdmin()); allow write: if false; }
    match /invoices/{id} { allow read: if signedIn() && (resource.data.userId == uid() || isAdmin()); allow write: if false; }
    match /refunds/{id}  { allow read: if signedIn() && (resource.data.userId == uid() || resource.data.organizerId == uid() || isAdmin()); allow write: if false; }
    match /tickets/{id}  { allow read: if signedIn() && (resource.data.userId == uid() || resource.data.organizerId == uid() || isAdmin()); allow write: if false; }
    match /payouts/{id}  { allow read: if signedIn() && (resource.data.organizerId == uid() || isAdmin()); allow write: if false; }

    // ── teams ──────────────────────────────────────────────────────────────
    match /teams/{teamId} {
      allow read: if signedIn();
      allow write: if false; // create/join/leave/transfer via API

      match /private/{docId} {
        allow read: if signedIn() && uid() in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds;
        allow write: if false;
      }
      match /messages/{mid} {
        allow read: if signedIn() && uid() in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds;
        allow create: if signedIn()
          && uid() in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds
          && request.resource.data.senderId == uid()
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 4000
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && resource.data.senderId == uid();
      }
    }
    match /teamInvitations/{id} {
      allow read: if signedIn() && (resource.data.inviterId == uid() || resource.data.inviteeEmail == request.auth.token.email || resource.data.inviteeId == uid());
      allow write: if false;
    }

    // ── projects ───────────────────────────────────────────────────────────
    match /projects/{pid} {
      allow read: if (resource.data.isPublic == true && resource.data.status == 'published')
                  || (signedIn() && (uid() in resource.data.memberIds || isAdmin()));
      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && uid() in request.resource.data.memberIds
        && request.resource.data.likesCount == 0
        && request.resource.data.viewsCount == 0;
      allow update: if signedIn() && uid() in resource.data.memberIds
        && noneOf(['ownerId', 'likesCount', 'viewsCount', 'bookmarksCount', 'linkedHackathons', 'createdAt']);
      allow delete: if signedIn() && resource.data.ownerId == uid();

      match /likes/{likerId} { allow read: if true; allow write: if false; } // via API (counter)
      match /comments/{cid} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.authorId == uid()
          && request.resource.data.body is string && request.resource.data.body.size() <= 2000;
        allow delete: if signedIn() && (resource.data.authorId == uid() || isModerator());
        allow update: if false;
      }
    }

    // ── submissions & judging ──────────────────────────────────────────────
    match /submissions/{id} {
      allow read: if resource.data.isPublic == true
        || (signedIn() && (uid() in resource.data.memberIds
                           || resource.data.organizerId == uid()
                           || (resource.data.judgeIds is list && uid() in resource.data.judgeIds)
                           || isAdmin()));
      allow write: if false;
    }
    match /submissionSnapshots/{id} {
      allow read: if signedIn() && (uid() in resource.data.memberIds || resource.data.organizerId == uid() || isAdmin());
      allow write: if false;
    }
    match /evaluations/{id} {
      allow read: if signedIn() && (resource.data.judgeId == uid() || resource.data.organizerId == uid() || isAdmin());
      allow write: if false;
    }
    match /winners/{id}      { allow read: if true; allow write: if false; }
    match /certificates/{id} { allow read: if true; allow write: if false; }

    // ── social ─────────────────────────────────────────────────────────────
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == uid();
      allow update: if signedIn() && resource.data.userId == uid() && onlyChanges(['isRead', 'readAt', 'updatedAt']);
      allow delete: if signedIn() && resource.data.userId == uid();
      allow create: if false;
    }
    match /bookmarks/{id} {
      allow read: if signedIn() && resource.data.userId == uid();
      allow create: if signedIn() && request.resource.data.userId == uid()
        && id == uid() + '_' + request.resource.data.hackathonId;
      allow delete: if signedIn() && resource.data.userId == uid();
      allow update: if false;
    }
    match /follows/{id}           { allow read: if true; allow write: if false; } // via API (counters)
    match /moderationReports/{id} {
      allow create: if signedIn() && request.resource.data.reporterId == uid() && request.resource.data.status == 'open';
      allow read, update: if isModerator();
      allow delete: if false;
    }
    match /mentorSessions/{id}  { allow read: if signedIn(); allow write: if false; }
    match /organizations/{id}   { allow read: if true; allow write: if false; }

    // ── server-only / admin-readable ───────────────────────────────────────
    match /auditLogs/{id}      { allow read: if isAdmin(); allow write: if false; }
    match /emailLog/{id}       { allow read: if isAdmin(); allow write: if false; }
    match /webhookEvents/{id}  { allow read: if isAdmin(); allow write: if false; }
    match /contactMessages/{id}{ allow read: if isAdmin(); allow write: if false; }
    match /reminderLog/{id}    { allow read, write: if false; }

    // Legacy landing-page logos
    match /collaborations/{id} { allow read: if true; allow write: if false; }

    // Everything else: deny.
    match /{document=**} { allow read, write: if false; }
  }
}
