{
  "name": "hacksyra",
  "version": "0.1.0",
  "description": "HACKSYRA - A Global Platform for Hackathons & Builders. An Innovation Hacks Product.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "emulators": "firebase emulators:start --project demo-hacksyra",
    "emulators:persist": "firebase emulators:start --project demo-hacksyra --import=.emulator-data --export-on-exit=.emulator-data",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "make-admin": "tsx scripts/make-admin.ts",
    "rules:deploy": "firebase deploy --only firestore:rules,firestore:indexes,storage"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.62.7",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^13.0.1",
    "framer-motion": "^11.11.17",
    "jose": "^6.2.18",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.462.0",
    "nanoid": "^6.0.2",
    "next": "^15.0.3",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.4.49",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.2",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^10.1.0",
    "recharts": "^2.13.3",
    "remark-gfm": "^4.0.1",
    "resend": "^6.39.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.9.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
