# ─────────────────────────────────────────────────────────────────────────────
# HACKSYRA — environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# Values left as placeholders are treated as "not configured" and the app shows
# a clear in-app notice instead of faking success.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HACKSYRA

# ── Local development with the Firebase Emulator Suite ───────────────────────
# true → client + server talk to local emulators (project "demo-hacksyra").
# Start them with `npm run emulators`, then `npm run seed`.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# ── Firebase web app (Console → Project settings → Your apps) ────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
# Show the GitHub button (enable the provider in Firebase Auth first)
NEXT_PUBLIC_AUTH_GITHUB_ENABLED=false

# ── Firebase Admin SDK (server only — service account JSON fields) ───────────
FIREBASE_ADMIN_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"

# ── Admin bootstrap ──────────────────────────────────────────────────────────
# Comma-separated emails that become super_admin on first sign-in
# (email must be VERIFIED — e.g. Google sign-in, or verified via the link).
ADMIN_EMAILS=

# ── Razorpay (all money flows through the platform account) ──────────────────
# Use TEST keys (rzp_test_...) in development: Dashboard → Settings → API Keys.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
# Dashboard → Settings → Webhooks → secret for /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Dev-only escape hatch: mark payments paid WITHOUT Razorpay. Only honoured when
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true and never on Vercel production.
PAYMENTS_DEV_BYPASS=false

# ── Tickets ──────────────────────────────────────────────────────────────────
# Random 32+ char secret used to HMAC-sign ticket QR codes.
TICKET_QR_SECRET=your-long-random-secret

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="HACKSYRA <noreply@yourdomain.com>"

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Shared secret for GET /api/cron/tick (GitHub Actions / Vercel Cron send it).
CRON_SECRET=your-long-random-secret

# ── Rate limiting (optional — falls back to in-memory) ───────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
